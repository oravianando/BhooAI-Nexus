# BhooAI Nexus - production environment.
# Copy to .env on the VPS and fill in real secrets. NEVER commit the real .env.
# The compose stack reads this file; real environment variables always win.

# Runtime
NEXUS_ENV=production
NEXUS_SERVER_HOST=0.0.0.0
NEXUS_SERVER_PORT=4000
NEXUS_FRONTEND_HOST=0.0.0.0
NEXUS_FRONTEND_PORT=3000
NEXUS_ADMIN_HOST=0.0.0.0
NEXUS_ADMIN_PORT=3001

# JWT - REQUIRED. Generate with: openssl rand -base64 48
NEXUS_AUTH_JWT_SECRET=

# Databases (compose-internal defaults; override if using hosted Mongo/Redis)
NEXUS_DB_URI=mongodb://mongo:27017/nexus
NEXUS_REDIS_URL=redis://redis:6379

# AI server (compose service; override to point elsewhere if needed)
NEXUS_AI_SERVER_URL=http://ai:8000

# ---- Payments (leave blank to keep a provider off) ----
NEXUS_PAYMENTS_RAZORPAY_KEY_ID=
NEXUS_PAYMENTS_RAZORPAY_KEY_SECRET=
NEXUS_PAYMENTS_PAYPAL_CLIENT_ID=
NEXUS_PAYMENTS_PAYPAL_CLIENT_SECRET=
NEXUS_PAYMENTS_PAYU_MERCHANT_KEY=
NEXUS_PAYMENTS_PAYU_SALT=
NEXUS_PAYMENTS_SKRILL_MERCHANT_EMAIL=
NEXUS_PAYMENTS_PAYONEER_PROGRAM_ID=
NEXUS_PAYMENTS_PAYONEER_API_KEY=

# ---- OAuth (leave blank to keep OAuth off) ----
NEXUS_AUTH_GOOGLE_CLIENT_ID=
NEXUS_AUTH_GOOGLE_CLIENT_SECRET=
NEXUS_AUTH_FACEBOOK_CLIENT_ID=
NEXUS_AUTH_FACEBOOK_CLIENT_SECRET=

# ---- AI provider API keys (fill what you use) ----
NEXUS_AI_OPENAI_API_KEY=
NEXUS_AI_ANTHROPIC_API_KEY=
NEXUS_AI_GOOGLE_API_KEY=
NEXUS_AI_GROQ_API_KEY=
NEXUS_AI_MISTRAL_API_KEY=
NEXUS_AI_COHERE_API_KEY=
NEXUS_AI_TOGETHER_API_KEY=
NEXUS_AI_FIREWORKS_API_KEY=
NEXUS_AI_DEEPSEEK_API_KEY=
NEXUS_AI_PERPLEXITY_API_KEY=
NEXUS_AI_XAI_API_KEY=
NEXUS_AI_REPLICATE_API_KEY=
NEXUS_AI_HUGGINGFACE_API_KEY=
NEXUS_AI_NVIDIA_API_KEY=
NEXUS_AI_OPENROUTER_API_KEY=
NEXUS_AI_ALEPHALPHA_API_KEY=
NEXUS_AI_STABILITY_API_KEY=
NEXUS_AI_AZURE_API_KEY=

# ---- Email (log provider by default; uncomment + set to switch to smtp) ----
NEXUS_EMAIL_PROVIDER=log
NEXUS_EMAIL_FROM=no-reply@bhooai.com
# NEXUS_EMAIL_SMTP_HOST=
# NEXUS_EMAIL_SMTP_PORT=
# NEXUS_EMAIL_SMTP_USER=
# NEXUS_EMAIL_SMTP_PASS=
