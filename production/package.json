{
  "name": "bhooai-nexus",
  "version": "0.1.1",
  "bin": {
    "nexus": "bin/nexus.js"
  },
  "exports": {
    ".": "./packages/nexus-core/src/index.ts",
    "./core": "./packages/nexus-core/src/index.ts",
    "./core/http": "./packages/nexus-core/src/http/index.ts",
    "./auth": "./packages/nexus-auth/src/index.ts",
    "./data": "./packages/nexus-data/src/index.ts",
    "./telemetry": "./packages/nexus-telemetry/src/index.ts",
    "./cli": "./packages/nexus-cli/src/index.ts",
    "./admin": "./packages/nexus-admin/src/App.tsx",
    "./admin/style.css": "./packages/nexus-admin/src/index.css",
    "./cluster": "./packages/nexus-cluster/src/index.ts",
    "./ai-client": "./packages/nexus-ai-client/src/index.ts",
    "./cache": "./packages/nexus-cache/src/index.ts",
    "./crypto": "./packages/nexus-crypto/src/index.ts",
    "./email": "./packages/nexus-email/src/index.ts",
    "./payments": "./packages/nexus-payments/src/index.ts",
    "./plugins": "./packages/nexus-plugins/src/index.ts",
    "./realtime": "./packages/nexus-realtime/src/index.ts",
    "./safe-goto": "./packages/nexus-safe-goto/src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "packages/nexus-auth/src/",
    "packages/nexus-auth/package.json",
    "packages/nexus-core/src/",
    "packages/nexus-core/package.json",
    "packages/nexus-data/src/",
    "packages/nexus-data/package.json",
    "packages/nexus-cli/src/",
    "packages/nexus-cli/package.json",
    "packages/nexus-cli/templates/",
    "packages/nexus-telemetry/src/",
    "packages/nexus-telemetry/package.json",
    "packages/nexus-realtime/src/",
    "packages/nexus-realtime/package.json",
    "packages/nexus-graphql/src/",
    "packages/nexus-graphql/package.json",
    "packages/nexus-cache/src/",
    "packages/nexus-cache/package.json",
    "packages/nexus-email/src/",
    "packages/nexus-email/package.json",
    "packages/nexus-payments/src/",
    "packages/nexus-payments/package.json",
    "packages/nexus-crypto/src/",
    "packages/nexus-crypto/package.json",
    "packages/nexus-ads/src/",
    "packages/nexus-ads/package.json",
    "packages/nexus-plugins/src/",
    "packages/nexus-plugins/package.json",
    "packages/nexus-ai-client/src/",
    "packages/nexus-ai-client/package.json",
    "packages/nexus-admin/src/",
    "packages/nexus-admin/package.json",
    "apps/admin/src/",
    "apps/admin/public/",
    "apps/admin/index.html",
    "apps/admin/package.json",
    "apps/admin/postcss.config.js",
    "apps/admin/tailwind.config.js",
    "apps/admin/tsconfig.json",
    "apps/admin/vite.config.ts"
  ],
  "description": "BhooAI Nexus — a Node-based full-stack framework (websockets, GraphQL federation, inbuilt security, custom ODM, OAuth, payments, WebRTC, AI, plugins).",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node bin/nexus.js build",
    "dev": "node bin/nexus.js dev",
    "test": "node bin/nexus.js test",
    "init": "node bin/nexus.js init",
    "doctor": "node bin/nexus.js doctor",
    "lint": "eslint \"packages/**/*.ts\" \"apps/**/*.{ts,tsx}\"",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.5.0",
    "eslint": "^9.10.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "mongodb": "^6.9.0",
    "together-ai": "^0.47.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  }
}
