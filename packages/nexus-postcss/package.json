{
  "name": "@bhooai/nexus-postcss",
  "version": "0.1.5",
  "description": "Opinionated PostCSS preset for BhooAI Nexus apps — Tailwind, nesting, future CSS, autoprefixing, and minification in one curated pipeline.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./theme.css": "./src/theme.css",
    "./theme-light-dark.css": "./src/theme-light-dark.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "lightningcss": "^1.26.0",
    "postcss": "^8.4.47",
    "postcss-import": "^16.1.0",
    "postcss-lightningcss": "^1.0.1",
    "postcss-logical": "^8.0.0",
    "postcss-nested": "^6.2.0",
    "postcss-nesting": "^12.1.5",
    "postcss-preset-env": "^9.6.0",
    "tailwindcss": "^3.4.13"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
