# BhooAI Nexus — environment template. Copy to .env and fill in.
# Every NEXUS_* var maps onto the config tree (nested keys use _ as separator).

# Server
NEXUS_SERVER_PORT=4000
NEXUS_SERVER_HOST=0.0.0.0
# 12 MiB request envelope for the default 10 MiB upload limit.
NEXUS_SERVER_BODY_LIMIT=12582912

# Uploads are persisted under this project-local directory.
NEXUS_UPLOADS_DIR=uploads
NEXUS_UPLOADS_PATH=/uploads

# MongoDB (required for auth/persistence)
NEXUS_DB_URI=mongodb://localhost:27017/myapp

# Redis (optional — used for cache, sessions, WS fanout, rate limiting)
NEXUS_REDIS_URL=redis://localhost:6379

# Auth — change this! Any random string >= 32 chars.
NEXUS_AUTH_JWT_SECRET=change-me-please-make-this-long-and-random

# Python AI server (optional)
NEXUS_AI_SERVER_URL=http://localhost:8000

# Payments — a provider activates once its keys are set (leave blank to disable).
NEXUS_PAYMENTS_RAZORPAY_KEY_ID=
NEXUS_PAYMENTS_RAZORPAY_KEY_SECRET=

# OAuth (optional)
NEXUS_AUTH_GOOGLE_CLIENT_ID=
NEXUS_AUTH_GOOGLE_CLIENT_SECRET=
NEXUS_AUTH_FACEBOOK_CLIENT_ID=
NEXUS_AUTH_FACEBOOK_CLIENT_SECRET=
